{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Word Atlas",
  "version": "1.0.0",
  "identifier": "com.wordatlas.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5188",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "词光 Word Atlas",
        "width": 1100,
        "height": 700,
        "minWidth": 880,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#0D1120",
        "zoomHotkeysEnabled": false,
        "devtools": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "一词一画，点亮雅思",
    "longDescription": "7,298 个雅思核心词，每个词一幅原创插画、两句原创例句和英美发音。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
